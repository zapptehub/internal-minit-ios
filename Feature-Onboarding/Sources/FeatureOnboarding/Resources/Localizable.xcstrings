    "onboarding.name.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hello! Welcome to Minit"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahoj! Vitaj v Minit"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szia! Üdv a Minitben"
          }
        }
      }
    },
    "onboarding.language.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So we understand each other better."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby sme si lepšie rozumeli."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogy jobban megértsük egymást."
          }
        }
      }
    },
    "onboarding.loyalty.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every bite is a reward."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé sústo je odmena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden falat jutalom."
          }
        }
      }
    },
    "onboarding.finish.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every bite is a reward."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
