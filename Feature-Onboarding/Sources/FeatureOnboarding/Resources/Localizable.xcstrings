    "onboarding.loyalty.headline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a new or add an existing minit loyalty card"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvor novú alebo pridaj existujúcu minit vernostnú kartu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozz létre újat, vagy add hozzá a meglévő minit hűségkártyádat"
          }
        }
      }
    },
    "onboarding.loyalty.option.newCustomer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm a new Minit customer"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Som nový zákazník Minit"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Új Minit-vásárló vagyok"
          }
        }
      }
