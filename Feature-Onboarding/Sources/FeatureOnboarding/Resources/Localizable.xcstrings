    "onboarding.finish.headline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finishing up your experience"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokončujeme tvoj zážitok"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Befejezzük az élményedet"
          }
        }
      }
