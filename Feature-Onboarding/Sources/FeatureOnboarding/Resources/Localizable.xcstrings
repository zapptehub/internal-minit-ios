    "onboarding.finish.creating.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creating loyalty card..."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvára sa vernostná karta..."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hűségkártya létrehozása..."
          }
        }
      }
    },
    "onboarding.finish.processing.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing loyalty card..."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spracováva sa vernostná karta..."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hűségkártya feldolgozása..."
          }
        }
      }
    },
    "onboarding.finish.processing.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This may take a second"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môže to chvíľu trvať"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez eltarthat egy pillanatig"
          }
        }
      }
    },
    "onboarding.finish.success.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loyalty card was added successfully"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vernostná karta bola úspešne pridaná"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hűségkártya sikeresen hozzáadva"
          }
        }
      }
    },
    "onboarding.scanner.caption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fit the QR code on your loyalty card."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarovnaj QR kód na svojej vernostnej karte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Illeszd a QR-kódot a hűségkártyádra."
          }
        }
      }
    },
    "onboarding.manualEntry.headline": {
      "comment": "Provisional copy — no designer reference for the manual card-entry fallback.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your loyalty card code"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadaj kód svojej vernostnej karty"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add meg a hűségkártyád kódját"
          }
        }
      }
    },
    "onboarding.manualEntry.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Card code"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kód karty"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kártyakód"
          }
        }
      }
    },
    "onboarding.alert.bootstrapFailed.message": {
      "comment": "Shown when bootstrap cannot determine whether a loyalty card is already linked.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't check your loyalty card. Check your connection and try again."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa overiť tvoju vernostnú kartu. Skontroluj pripojenie a skús znova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült ellenőrizni a hűségkártyádat. Ellenőrizd a kapcsolatot, és próbáld újra."
          }
        }
      }
    },
    "onboarding.alert.createFailed.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niečo sa pokazilo"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valami hiba történt"
          }
        }
      }
    },
    "onboarding.alert.alreadyClaimed.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Card already linked"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta už je prepojená"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kártya már kapcsolva van"
          }
        }
      }
    },
    "onboarding.alert.alreadyClaimed.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This card is already linked to another account."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto karta je už prepojená s iným účtom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a kártya már egy másik fiókhoz van kapcsolva."
          }
        }
      }
    },
    "onboarding.alert.cameraDenied.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access needed"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Je potrebný prístup ku kamere"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerahozzáférés szükséges"
          }
        }
      }
    },
    "onboarding.alert.cameraDenied.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable the camera in Settings, or enter your loyalty card code manually."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľ kameru v Nastaveniach, alebo zadaj kód vernostnej karty ručne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a kamerát a Beállításokban, vagy add meg manuálisan a hűségkártyád kódját."
          }
        }
      }
    },
    "onboarding.alert.action.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        },
        "sk": {
