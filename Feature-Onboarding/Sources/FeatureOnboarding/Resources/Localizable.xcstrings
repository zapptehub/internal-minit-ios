{
  "sourceLanguage": "en",
  "strings": {
    "onboarding.error.corruptedProgress": {
      "comment": "Shown inline when locally saved onboarding progress can't be read back (Task 4.1 bootstrap fallback) — onboarding restarts from the name step.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't restore your progress, so let's start again."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa nám obnoviť tvoj postup, začnime znova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült visszaállítani a folyamatodat, kezdjük újra."
          }
        }
      }
    },
    "onboarding.placeholder.headline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Onboarding"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Onboarding"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Onboarding"
          }
        }
      }
    },
    "onboarding.placeholder.subtitle": {
      "comment": "Temporary placeholder copy until Task 4.1 replaces this screen with the real flow.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screens land in Tasks 4.2–4.5. Tap below to exit early during development."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazovky pribudnú v úlohách 4.2–4.5. Klepnutím nižšie ukončíte počas vývoja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A képernyők a 4.2–4.5 feladatokban érkeznek. Fejlesztés közben az alábbi gombbal kiléphetsz."
          }
        }
      }
    },
    "onboarding.name.headline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What should I call you?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako ťa mám volať?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogyan szólítsalak?"
          }
        }
      }
    },
    "onboarding.name.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your name"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadaj svoje meno"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add meg a neved"
          }
        }
      }
    },
