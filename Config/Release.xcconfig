// Base for the Release configuration of the minit target.
// Does not include Local.xcconfig or Secrets.xcconfig. HTTP and empty
// Access values are hardcoded after the Sentry include.
#include "Sentry.xcconfig"

// xcconfig treats // as a comment, so the base URL is split the same way as SENTRY_DSN.
// Public path on the zappte host. No /mock prefix and no Cloudflare Access.
MINIT_API_BASE_URL = https:/$()/api.zappte.eu/min

SENTRY_ENVIRONMENT = release
MINIT_DATA_BACKEND = http
// Demo mode never ships in Release.
MINIT_DEMO_ENABLED = NO
CF_ACCESS_CLIENT_ID =
CF_ACCESS_CLIENT_SECRET =
MINIT_SHAKE_REPORT_EMAIL =

// Store builds send no Sentry PII. Debug and Internal omit this flag.
// A later TestFlight configuration must omit it too.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = MINIT_SENTRY_NO_PII
