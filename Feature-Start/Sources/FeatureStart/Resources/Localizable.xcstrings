    "start.demo.alert.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demo mode lets you try the app without logging in or onboarding – you go straight to Home. Changes aren't saved, and logging out ends the demo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A demó módban kipróbálhatod az alkalmazást bejelentkezés és regisztráció nélkül – rögtön a Kezdőlapra jutsz. A módosításaid nem mentődnek, a kijelentkezéssel pedig véget ér a demó."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demo režim vám umožní vyskúšať aplikáciu bez prihlásenia a registrácie – hneď sa dostanete na Domov. Zmeny sa neukladajú a odhlásením sa demo skončí."
          }
        }
      }
    },
    "start.headline" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make your\nday better"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tedd szebbé\na napodat"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urob svoj\ndeň lepším"
          }
        }
      }
    },
    "start.legal" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By tapping “Get started” you’re accepting our [terms](https://www.google.com) and [privacy policy](https://www.google.com)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A „Kezdjük el” gombra kattintva elfogadod [felhasználási feltételeinket](https://www.google.com) és [adatvédelmi szabályzatunkat](https://www.google.com)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknutím na „Začať” súhlasíte s našimi [podmienkami](https://www.google.com) a [zásadami ochrany osobných údajov](https://www.google.com)."
