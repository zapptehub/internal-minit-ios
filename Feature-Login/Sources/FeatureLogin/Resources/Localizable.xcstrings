    "createAccount.checkbox.marketingOptIn" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We may email you occasionally about updates and services similar to those we offer on our platform. You can opt out at any time by adjusting your preferences regarding commercial communications in the settings."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Időnként e-mailben tájékoztathatjuk frissítésekről és az általunk kínált szolgáltatásokhoz hasonló ajánlatokról. A beállításokban bármikor leiratkozhatsz a kereskedelmi célú értesítésekről."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Občas vám môžeme poslať e-mail o aktualizáciách a službách podobných tým, ktoré ponúkame na našej platforme. Kedykoľvek sa môžete odhlásiť úpravou nastavení obchodnej komunikácie."
          }
        }
      }
    },
